# Copy to .env and fill in. NEVER commit .env.
# Binance API key: enable "Spot & Margin Trading" only. Do NOT enable withdrawals.
# Restrict the key to your IP address in Binance API settings.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# false = dry run (no real orders). Set to true only after testing.
BOT_LIVE=false

BOT_QUOTE=USDT
BOT_INTERVAL=15m
BOT_TRADE_SIZE=20
BOT_MAX_OPEN_POSITIONS=3
BOT_MAX_TOTAL=60
BOT_TAKE_PROFIT_PCT=3
BOT_STOP_LOSS_PCT=5
BOT_MAX_DAILY_LOSS=20
BOT_IGNORE_ASSETS=BNB
BOT_MANAGE_EXISTING=true
